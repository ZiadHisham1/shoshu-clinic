# ═══════════════════════════════════════════════════════════════
# Capacitor
# ═══════════════════════════════════════════════════════════════

# Capacitor's generated web assets (rebuilt by `npx cap sync`)
android/app/src/main/assets/public/
ios/App/App/public/

# Capacitor config plugins cache
.capacitor/

# iOS — CocoaPods
ios/App/Pods/
ios/App/Podfile.lock
ios/App/build/
ios/DerivedData/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/xcuserdata/
ios/App/*.xcworkspace/xcuserdata/

# Android — Gradle
android/.gradle/
android/build/
android/app/build/
android/captures/
android/local.properties
android/.idea/
android/*.iml
android/app/release/
android/app/debug/
android/.cxx/

# Android — Keystore files (SECRET — never commit!)
*.jks
*.keystore
android/app/*.keystore

# Xcode
*.xcuserstate
*.xcuserdatad/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3

# Native temp/build folders
*.hprof
*.log
.DS_Store

# ═══════════════════════════════════════════════════════════════
# Capacitor — native projects (regenerated by `npx cap add <platform>`)
# ═══════════════════════════════════════════════════════════════
/android/
/ios/
# ═══════════════════════════════════════════════════════════════
# Environment variables — NEVER COMMIT
# ═══════════════════════════════════════════════════════════════
.env
.env.local
.env.*.local
.env.production
.env.development

# ═══════════════════════════════════════════════════════════════
# TypeScript incremental build info
# ═══════════════════════════════════════════════════════════════
*.tsbuildinfo
tsconfig.tsbuildinfo

# ═══════════════════════════════════════════════════════════════
# Next.js generated
# ═══════════════════════════════════════════════════════════════
next-env.d.ts

# ═══════════════════════════════════════════════════════════════
# Capacitor generated
# ═══════════════════════════════════════════════════════════════
/android/
/ios/
.capacitor/

# ═══════════════════════════════════════════════════════════════
# Build outputs
# ═══════════════════════════════════════════════════════════════
.next/
out/
build/
dist/
node_modules/

# ═══════════════════════════════════════════════════════════════
# Logs / caches
# ═══════════════════════════════════════════════════════════════
*.log
.cache/
.eslintcache

